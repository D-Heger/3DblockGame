{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "./VoxelGame",
          "files": "**/*.csproj"
        },
        {
          "src": "./Tests",
          "files": "**/*.csproj"
        }
      ],
      "dest": "api",
      "properties": {
        "Configuration": "Release"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": ["**/*.{md,yml}"],
        "exclude": ["_site/**"]
      }
    ],
    "resource": [
      {
        "files": []
      }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "3D Voxel Game",
      "_appTitle": "3D Voxel Game",
      "_enableSearch": true,
      "pdf": false,
      "author": "David Heger",
      "version": "0.1.0",
      "description": "This is a project for a 3D voxel-based game."
    }
  }
}
